{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "简记桌面端默认权限集",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "fs:default",
    "updater:default",
    "process:default",
    "notification:default",
    {
      "identifier": "fs:scope",
      "allow": ["$APPDATA/**", "$RESOURCE/**"]
    }
  ]
}
